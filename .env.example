# Server-only AI providers. Never place real values in Git.
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=

# OpenRouter is preferred; Hugging Face is the automatic fallback.
AI_PROVIDER=openrouter
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=openrouter/free
OPENROUTER_WEB_SEARCH=true
HUGGINGFACE_MODEL=openai/gpt-oss-120b:fastest

# Optional direct market-data adapters.
CMC_API_KEY=
COINALYZE_API_KEY=
OPENMARKET_API_KEY=

# Guarded eToro execution. PAPER is the fail-safe default.
# Modes: PAPER | DEMO_EXCHANGE | LIVE
TRADING_MODE=PAPER
ETORO_API_KEY=
ETORO_USER_KEY=

# Separate website operator login. Do not reuse an eToro or AI password.
OPERATOR_PASSWORD=
SESSION_SECRET=
EXECUTION_SIGNING_SECRET=

# Both flags must be true before any broker order can be submitted.
# LIVE additionally requires TRADING_MODE=LIVE and LIVE_TRADING_ENABLED=true.
EXCHANGE_WRITES_ENABLED=false
LIVE_TRADING_ENABLED=false

# Explicit eToro symbols only. Start with a very small list in DEMO.
EXECUTION_ALLOWED_SYMBOLS=BTC,ETH
EXECUTION_MAX_ORDER_USD=100
EXECUTION_MAX_RISK_USD=5
EXECUTION_MAX_OPEN_POSITIONS=1
EXECUTION_MAX_DAILY_LOSS_USD=25
EXECUTION_MAX_SPREAD_PCT=0.5
EXECUTION_MAX_ENTRY_DEVIATION_PCT=0.75

# Omit to use the safe default: false in PAPER/DEMO, true on every LIVE boot.
# EXECUTION_KILL_SWITCH=true

PORT=4173
